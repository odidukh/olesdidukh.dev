# Resend API Key for contact form emails
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxx

# Email address to receive contact form submissions
CONTACT_EMAIL=your-email@example.com

# Buttondown API Key for newsletter subscriptions
# Get your API key at https://buttondown.email/settings/api
BUTTONDOWN_API_KEY=your-buttondown-api-key

# Sentry Error Monitoring (Optional)
# Get your DSN at https://sentry.io/settings/projects/
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Sentry Organization and Project (for source maps)
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token
