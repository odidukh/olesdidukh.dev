# =============================================================================
# Environment Variables for Personal Website v2
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Required - Core Services
# -----------------------------------------------------------------------------

# Supabase (Database & Auth)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Email Service (Resend)
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Optional - Enhanced Features
# -----------------------------------------------------------------------------

# Admin Authentication
# Email address that can access /admin routes (must exist in Supabase Auth)
ADMIN_EMAIL=your-email@example.com

# Contact Form
# Where to send contact form submissions (defaults to ADMIN_EMAIL if not set)
CONTACT_EMAIL=contact@example.com

# Rate Limiting (Upstash Redis)
# Get these from: https://console.upstash.com/redis
# Without these, rate limiting falls back to in-memory (not recommended for production)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Newsletter Service (Buttondown)
# Get this from: https://buttondown.email/settings
BUTTONDOWN_API_KEY=your-buttondown-api-key

# -----------------------------------------------------------------------------
# Optional - Analytics & Monitoring
# -----------------------------------------------------------------------------

# Google Analytics
# Get this from: https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity (Heatmaps & Session Recording)
# Get this from: https://clarity.microsoft.com/
NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx

# Sentry (Error Tracking)
# Get these from: https://sentry.io/settings/
SENTRY_DSN=https://xxxx@xxx.ingest.sentry.io/xxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxx.ingest.sentry.io/xxxx
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Development Only
# -----------------------------------------------------------------------------

# Bundle Analyzer (set to 'true' to enable)
# ANALYZE=true

# -----------------------------------------------------------------------------
# CI/CD (automatically set in most CI environments)
# -----------------------------------------------------------------------------

# CI=true
